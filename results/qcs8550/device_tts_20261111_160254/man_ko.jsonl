{"id": "ko000", "task": "tts", "tgt": "ko", "text": "전화가 왔어요"}
{"id": "ko001", "task": "tts", "tgt": "ko", "text": "베트남어 가이드가 있나요?"}
{"id": "ko002", "task": "tts", "tgt": "ko", "text": "시간이 있을 때 뭐 하세요?"}
{"id": "ko003", "task": "tts", "tgt": "ko", "text": "아무 것도 없어요"}
{"id": "ko004", "task": "tts", "tgt": "ko", "text": "죄송합니다, 시내에 가면 어디에 있는지 알 수 있을까요?"}
{"id": "ko005", "task": "tts", "tgt": "ko", "text": "어디 계세요?"}
{"id": "ko006", "task": "tts", "tgt": "ko", "text": "저는 차분한 색상을 좋아해요."}
{"id": "ko007", "task": "tts", "tgt": "ko", "text": "골라 주세요."}
{"id": "ko008", "task": "tts", "tgt": "ko", "text": "각자 계산할게요."}
{"id": "ko009", "task": "tts", "tgt": "ko", "text": "여기 뭐 맛있어요?"}
{"id": "ko010", "task": "tts", "tgt": "ko", "text": "베트남으로 돌아가는 게 낫겠어요."}
{"id": "ko011", "task": "tts", "tgt": "ko", "text": "객실 서비스는 몇 번인가요?"}
{"id": "ko012", "task": "tts", "tgt": "ko", "text": "정말 만족합니다. 얼마죠?"}
{"id": "ko013", "task": "tts", "tgt": "ko", "text": "안전벨트는 어떻게 채우나요?"}
{"id": "ko014", "task": "tts", "tgt": "ko", "text": "우린 아직 만나지 않았어"}
{"id": "ko015", "task": "tts", "tgt": "ko", "text": "당신의 취미는 무엇인가요?"}
{"id": "ko016", "task": "tts", "tgt": "ko", "text": "오늘 체크아웃하고 싶어요."}
{"id": "ko017", "task": "tts", "tgt": "ko", "text": "심각한 건 아닌 것 같아요. 피로와 스트레스 때문이에요."}
{"id": "ko018", "task": "tts", "tgt": "ko", "text": "너무 넓어"}
{"id": "ko019", "task": "tts", "tgt": "ko", "text": "갈비구이가 있어요."}
{"id": "ko020", "task": "tts", "tgt": "ko", "text": "괜찮아요"}
{"id": "ko021", "task": "tts", "tgt": "ko", "text": "어젯밤부터였어요."}
{"id": "ko022", "task": "tts", "tgt": "ko", "text": "어떤 좌석을 원하세요?"}
{"id": "ko023", "task": "tts", "tgt": "ko", "text": "15,000원이에요."}
{"id": "ko024", "task": "tts", "tgt": "ko", "text": "너무 비싸요, 할인 안 되나요?"}
{"id": "ko025", "task": "tts", "tgt": "ko", "text": "지금 몇시죠?"}
{"id": "ko026", "task": "tts", "tgt": "ko", "text": "네, 도움이 필요하면 전화해줘요."}
{"id": "ko027", "task": "tts", "tgt": "ko", "text": "가을은 독서하기 가장 좋은 계절이에요."}
{"id": "ko028", "task": "tts", "tgt": "ko", "text": "저는 가을과 봄을 좋아해요."}
{"id": "ko029", "task": "tts", "tgt": "ko", "text": "네, 80달러입니다."}
{"id": "ko030", "task": "tts", "tgt": "ko", "text": "도착하면 알려줄 수 있나요?"}
{"id": "ko031", "task": "tts", "tgt": "ko", "text": "시원해요."}
{"id": "ko032", "task": "tts", "tgt": "ko", "text": "뒤에 건물이 나오게 찍어주세요."}
{"id": "ko033", "task": "tts", "tgt": "ko", "text": "다시 뒤집어 놓을 수 있고, 여기까지 고, 다시 을 수 있습니다."}
{"id": "ko034", "task": "tts", "tgt": "ko", "text": "여성복 코너는 몇 층인가요?"}
{"id": "ko035", "task": "tts", "tgt": "ko", "text": "하루에 얼마인가요?"}
{"id": "ko036", "task": "tts", "tgt": "ko", "text": "오늘은 제가 낼게요."}
{"id": "ko037", "task": "tts", "tgt": "ko", "text": "정확한 위치를 알려줘요"}
{"id": "ko038", "task": "tts", "tgt": "ko", "text": "앉을 수 있어?"}
{"id": "ko039", "task": "tts", "tgt": "ko", "text": "아마 감기인 것 같아요."}
{"id": "ko040", "task": "tts", "tgt": "ko", "text": "저 사람들이 먹는 건 무슨 요리인가요?"}
{"id": "ko041", "task": "tts", "tgt": "ko", "text": "감사합니다, 여기서 사진 인화도 해주나요?"}
{"id": "ko042", "task": "tts", "tgt": "ko", "text": "침대칸으로 바꾸고 싶은데 자리 있나요?"}
{"id": "ko043", "task": "tts", "tgt": "ko", "text": "그 이유가 뭐죠?"}
{"id": "ko044", "task": "tts", "tgt": "ko", "text": "오늘 무슨 요일이죠?"}
{"id": "ko045", "task": "tts", "tgt": "ko", "text": "기차표 예매하고 싶어요."}
{"id": "ko046", "task": "tts", "tgt": "ko", "text": "잘 자세요!"}
{"id": "ko047", "task": "tts", "tgt": "ko", "text": "위탁 수하물 있나요?"}
{"id": "ko048", "task": "tts", "tgt": "ko", "text": "길을 안내해 주실 수 있나요?"}
{"id": "ko049", "task": "tts", "tgt": "ko", "text": "햄버거 하나하고 작은 콜라 하나 주세요."}
{"id": "ko050", "task": "tts", "tgt": "ko", "text": "여름"}
{"id": "ko051", "task": "tts", "tgt": "ko", "text": "예약하고 싶어요"}
{"id": "ko052", "task": "tts", "tgt": "ko", "text": "도와주세요."}
{"id": "ko053", "task": "tts", "tgt": "ko", "text": "시내까지 얼마인가요?"}
{"id": "ko054", "task": "tts", "tgt": "ko", "text": "메뉴 여기 있어요."}
{"id": "ko055", "task": "tts", "tgt": "ko", "text": "속이지 마세요."}
{"id": "ko056", "task": "tts", "tgt": "ko", "text": "신호등 앞에 세워 주세요."}
{"id": "ko057", "task": "tts", "tgt": "ko", "text": "들어오세요"}
{"id": "ko058", "task": "tts", "tgt": "ko", "text": "네, 뭘 쓰세요?"}
{"id": "ko059", "task": "tts", "tgt": "ko", "text": "오늘 뭐 할 거예요?"}
